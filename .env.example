# =======================================================================
# Choose ONE LLM provider below.
# Keep only one provider block uncommented in .env.
# =======================================================================

## Option 1: Hugging Face Inference API (remote)
LLM_PROVIDER=hf
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=your-huggingface-token


## Option 2: Google Gemini (remote)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=your-gemini-api-key


## Option 3: OpenAI (remote)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your-openai-api-key


## Option 4: Ollama (local; API key is ignored but kept for config shape)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# LLM_API_KEY=not-used
# OLLAMA_BASE_URL=http://localhost:11434
## Docker-to-host Ollama URL:
# OLLAMA_BASE_URL=http://host.docker.internal:11434


## Option 5: OpenRouter (remote; use a provider/model identifier)
# LLM_PROVIDER=openrouter
# LLM_MODEL=provider/model
# LLM_API_KEY=your-openrouter-api-key

# =======================================================================

## LLM settings (optional)
LLM_MAX_CHUNKS=5
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

## Chunk settings
CHUNK_SIZE=800
CHUNK_OVERLAP=200

## Retrieval stage candidate limits
VECTOR_TOP_K=30
BM25_TOP_K=20
FUSION_TOP_K=15
MIN_RETRIEVAL_SCORE=0.3
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

## Output settings
STREAM=true
LINE_WIDTH=80

# =======================================================================
# Evaluation
# =======================================================================
# Optional Ragas judge settings. Leave both provider and model unset to use
# LLM_PROVIDER and LLM_MODEL. If you set one, set both.
# LLM_EVAL_PROVIDER=gemini
# LLM_EVAL_MODEL=gemini-2.5-flash
# Same-provider judges reuse LLM_API_KEY; a different remote provider needs
# LLM_EVAL_API_KEY. Ollama does not require an evaluation API key.
# LLM_EVAL_API_KEY=your-evaluation-provider-api-key

# =======================================================================
# Optional authenticated MCP search server
# =======================================================================
# Configure an OAuth authorization server that publishes OIDC discovery metadata
# and asymmetric JWT signing keys. The accepted token audience must equal the
# public Streamable HTTP endpoint below, and tokens need the read-only scope.
# MCP_ISSUER_URL=https://identity.example.com/
# MCP_RESOURCE_SERVER_URL=https://notes.example.com/mcp
# MCP_READ_SCOPE=notes:read
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# Host header allowlist for a stable HTTPS reverse proxy or tunnel hostname.
# MCP_ALLOWED_HOSTS=notes.example.com
